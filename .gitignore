__pycache__
# Hypothesis replays its past counter-examples from here on every run. Local
# and machine-specific: a shrunk failure is worth turning into a named regression
# test, not into a committed binary.
.hypothesis
*.egg-info

docs/Countercyclical+Investing_vF.1/
docs/AssetAllocationBook
docs/books

# Corpus books: copyrighted, large, and ingested from ~/data/investment/inbox
# at runtime — never part of the public repo (see docs/TASKS.md Task 3.1).
*.pdf
*.epub

# Dashboard (M10, ADR-005 amendment). The React front is 16 source files;
# everything below is machine-generated and must never enter the repo.
#
# node_modules is 9,405 files and 128MB of dependencies — three orders of
# magnitude more than the code it builds. `package-lock.json` IS committed, for
# the same reason `uv.lock` is: the lockfile is what makes the build
# reproducible, the tree it installs is not.
src/investment/ops/dashboard/node_modules/
# Build output — regenerated by `npm run build`, and a 678KB minified blob would
# change on every build for no reviewable diff. `ops/api.py` serves the exact
# build command when the directory is absent, so a fresh clone is told what to
# run rather than left with a blank page.
src/investment/ops/dashboard/dist/
*.tsbuildinfo
