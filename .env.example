# LLMs
# ANTHROPIC_API_KEY is optional — nothing reads it while every role goes
# through OpenRouter. Kept so reverting a role to a direct provider transport
# needs no schema change.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
OPENROUTER_API_KEY=sk-or-REPLACE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#
# THIS FILE DECIDES WHICH MODELS RUN. There is no default in the code, so both
# ids below are REQUIRED and the agent refuses to start without them — an
# unconfigured run must never be mistakable for a configured one.
#
# Any OpenRouter id works; the roles ask for capabilities, not for names:
#   PLANNER_MODEL  structured output + a reasoning-effort knob. Assembles the
#                  Worker's context and runs the post-cycle guardrail — a
#                  cheap/fast model is the intended fit.
#   WORKER_MODEL   structured output AND function tools IN THE SAME RUN (it
#                  calls the three bridged tools mid-reasoning), plus a
#                  reasoning-effort knob. The judgement-bearing call.
# Smoke-test both after a swap: a model that cannot do the above fails at the
# first real cycle, not at startup.
PLANNER_MODEL=REPLACE_ME
PLANNER_THINKING_BUDGET_PRE=512
PLANNER_THINKING_BUDGET_POST=1024
WORKER_MODEL=REPLACE_ME
EMBEDDING_MODEL=all-MiniLM-L6-v2

# SQLite ($HOME expanded by config.py)
DB_PATH=$HOME/data/investment/investment.db

# Scheduling
TZ=Europe/Zurich

# Ingestion
INBOX_PATH=$HOME/data/investment/inbox
SOURCES_PATH=$HOME/data/investment/sources/corpus

# Market data
FRED_API_KEY=REPLACE_ME
MARKET_BACKFILL_YEARS=35
# The fetch universe + composite definitions live in db/seed_data.py
# (ALLOWED_TICKERS is authoritative), not here.

# Local ops
LOCAL_API_PORT=8765

# Telegram
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_CHAT_ID=REPLACE_ME

# User profile defaults (BINDING rules — see REVISION_NOTES.md)
USER_CURRENCY=USD
USER_MAX_DRAWDOWN_PCT=-25
USER_MAX_SINGLE_ASSET_PCT=50
USER_BENCHMARK=all-weather-USD
USER_PHASE=accumulation
USER_AUTO_VALIDATION_HOURS=48
